<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CRONOS"
        android:textColor="@color/widget_text_tertiary"
        android:textSize="11sp"
        android:letterSpacing="0.12"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_session_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Sin sesión activa"
        android:textColor="@color/widget_text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_session_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <Chronometer
        android:id="@+id/widget_session_chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="--:--:--"
        android:textColor="@color/widget_accent"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="monospace" />

    <LinearLayout
        android:id="@+id/widget_session_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/widget_session_pause"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pausar"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="start" />

        <TextView
            android:id="@+id/widget_session_finish"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Finalizar"
            android:textColor="@color/widget_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>
</LinearLayout>
