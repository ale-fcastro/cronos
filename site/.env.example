# SMTP para el newsletter (/api/newsletter). Configurar en Vercel → Settings → Environment Variables.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Remitente (por defecto = EMAIL_HOST_USER)
DEFAULT_FROM_EMAIL=
# Opcional: te llega un aviso por cada suscripción nueva
NEWSLETTER_NOTIFY_TO=
