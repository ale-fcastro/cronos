---
// Marco de teléfono para capturas/video reales de la app.
interface Props {
  src?: string;
  video?: { mp4: string; webm?: string; poster?: string };
  alt?: string;
  class?: string;
  eager?: boolean;
}
const { src, video, alt = '', class: cls, eager = false } = Astro.props;
---
<div class:list={['phone', cls]}>
  <div class="screen">
    {video ? (
      <video autoplay muted loop playsinline preload="metadata" poster={video.poster} aria-label={alt}>
        {video.webm && <source src={video.webm} type="video/webm" />}
        <source src={video.mp4} type="video/mp4" />
      </video>
    ) : (
      <img src={src} alt={alt} width="640" height="1428" loading={eager ? 'eager' : 'lazy'} decoding="async" />
    )}
  </div>
</div>

<style>
  .phone {
    position: relative;
    width: 100%;
    max-width: 300px;
    aspect-ratio: 640 / 1428;
    padding: 10px;
    border-radius: 44px;
    background: linear-gradient(160deg, #2a2c32, #16171b);
    box-shadow:
      inset 0 0 0 1px #3a3d45,
      0 0 0 1px #0b0c0e,
      0 40px 80px -30px rgb(0 0 0 / .7),
      0 0 120px -40px color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .screen { width: 100%; height: 100%; border-radius: 34px; overflow: hidden; background: var(--bg); }
  .screen img, .screen video { width: 100%; height: 100%; object-fit: cover; display: block; }
</style>
