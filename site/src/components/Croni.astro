---
// Croni, la mascota de Cronos. Port a SVG de lib/shared/widgets/mascot/cronos_mascot.dart
// (viewBox 220x250 original). Estados animados con CSS: idle | wave | think | sleep | celebrate.
interface Props {
  size?: number;
  state?: 'idle' | 'wave' | 'think' | 'sleep' | 'celebrate';
  class?: string;
  label?: string;
}
const { size = 160, state = 'idle', class: cls, label = 'Croni, la mascota de Cronos' } = Astro.props;
const uid = `croni-${Math.random().toString(36).slice(2, 8)}`;
const sleeping = state === 'sleep';
---
<svg
  class:list={['croni', `is-${state}`, cls]}
  width={size}
  height={size * 250 / 220}
  viewBox="0 0 220 250"
  role="img"
  aria-label={label}
>
  <defs>
    <linearGradient id={`${uid}-g`} x1="52" y1="60" x2="168" y2="176" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#9AABE4" />
      <stop offset="1" stop-color="#7D90D6" />
    </linearGradient>
  </defs>

  <ellipse class="shadow" cx="110" cy="232" rx="56" ry="10" fill="#000" opacity=".28" />

  <g class="body">
    <!-- piernas -->
    <g class="leg leg-l"><rect x="89" y="176" width="12" height="42" rx="6" fill="#6A7CC4" /><path d="M76 214q0-6 6-6h15q6 0 6 6v3q0 5-6 5H82q-6 0-6-5z" fill="#E2E5EC" /></g>
    <g class="leg leg-r"><rect x="119" y="176" width="12" height="42" rx="6" fill="#6A7CC4" /><path d="M106 214q0-6 6-6h15q6 0 6 6v3q0 5-6 5h-15q-6 0-6-5z" fill="#E2E5EC" /></g>
    <!-- brazos -->
    <g class="arm arm-l"><rect x="52" y="116" width="12" height="50" rx="6" fill="#8496DA" /><ellipse cx="58" cy="169" rx="10" ry="11" fill="#E2E5EC" /></g>
    <g class="arm arm-r"><rect x="156" y="116" width="12" height="50" rx="6" fill="#8496DA" /><ellipse cx="162" cy="169" rx="10" ry="11" fill="#E2E5EC" /></g>
    <!-- mechón = manecillas -->
    <g class="tuft">
      <rect x="105.5" y="20" width="7" height="34" rx="3.5" fill="#DFE3EC" transform="rotate(-32 109 54)" />
      <rect x="105.5" y="20" width="7" height="34" rx="3.5" fill="#DFE3EC" transform="rotate(32 109 54)" />
      <circle cx="109" cy="54" r="4" fill="#EEF0F4" />
    </g>
    <!-- anillo "C": arranca a 38°, 74% de la vuelta -->
    <path d="M155.70 153.71 A58 58 0 1 1 142.77 70.14" fill="none" stroke={`url(#${uid}-g)`} stroke-width="24" stroke-linecap="round" />
    <!-- cejas -->
    <rect x="81" y="93" width="20" height="4.5" rx="2.2" fill="#5866A8" transform="rotate(4 91 95)" />
    <rect x="119" y="93" width="20" height="4.5" rx="2.2" fill="#5866A8" transform="rotate(-4 129 95)" />
    <!-- ojos -->
    <g class="eyes">
      {sleeping ? (
        <g fill="none" stroke="#CDD2DC" stroke-width="4.5" stroke-linecap="round">
          <path d="M80 112q12 10 24 0" /><path d="M116 112q12 10 24 0" />
        </g>
      ) : (
        <g class="blink">
          <circle cx="92" cy="111" r="15" fill="#fff" /><circle cx="128" cy="111" r="15" fill="#fff" />
          <g class="pupils">
            <circle cx="95" cy="113" r="7" fill="#20242C" /><circle cx="131" cy="113" r="7" fill="#20242C" />
            <circle cx="98" cy="110" r="1.8" fill="#fff" opacity=".85" /><circle cx="134" cy="110" r="1.8" fill="#fff" opacity=".85" />
          </g>
        </g>
      )}
    </g>
    <!-- camisa y corbata -->
    <g transform="translate(0 15) translate(110 156) scale(.76) translate(-110 -156)">
      <path d="M98 143q12-2 24 0l-8 43q-4 3-8 0z" fill="#EEF0F4" />
      <path d="M99 143l11 9-9 5z" fill="#D7DBE4" />
      <path d="M121 143l-11 9 9 5z" fill="#C6CBD6" />
      <path d="M105 150h10l-2 7h-6z" fill="#39406B" />
      <path d="M107.5 157h5l3 24-5.5 6-5.5-6z" fill="#2F3760" />
    </g>
    <!-- boca -->
    {(state === 'idle') && <path d="M102 141q8 4 16 0" fill="none" stroke="#E8E9ED" stroke-width="3.6" stroke-linecap="round" />}
    {(state === 'wave' || state === 'celebrate') && (
      <g><path d="M100 139q10-1 20 0q-3 14-10 14t-10-14z" fill="#20242C" /><path d="M104 148q6 4 12 0q-3 4-6 4t-6-4z" fill="#F0857A" /></g>
    )}
    {state === 'think' && <ellipse cx="110" cy="144" rx="4.5" ry="5.5" fill="none" stroke="#E8E9ED" stroke-width="3.2" />}
    {sleeping && <path d="M104 145q6 4 12 0" fill="none" stroke="#CDD2DC" stroke-width="3.2" stroke-linecap="round" />}
  </g>

  {sleeping && (
    <g class="zzz" font-family="IBM Plex Mono, monospace" font-weight="700" fill="#9DB1F5">
      <text class="z1" x="150" y="110" font-size="20">z</text>
      <text class="z2" x="150" y="110" font-size="26">Z</text>
    </g>
  )}
</svg>

<style>
  .croni { overflow: visible; display: block; }
  .croni * { transform-box: view-box; }
  .body { transform-origin: 110px 216px; }
  .arm-l { transform-origin: 58px 118px; }
  .arm-r { transform-origin: 162px 118px; }
  .leg-l { transform-origin: 95px 176px; }
  .leg-r { transform-origin: 125px 176px; }
  .tuft { transform-origin: 109px 54px; }
  .blink { transform-origin: 110px 113px; animation: blink 4.6s infinite; }
  .shadow { transform-origin: 110px 232px; }

  /* idle */
  .is-idle .body { animation: bob 3.4s ease-in-out infinite; }
  .is-idle .arm-l { animation: armL 3.4s ease-in-out infinite; }
  .is-idle .arm-r { animation: armR 3.4s ease-in-out infinite; }
  .is-idle .tuft { animation: tuft 3.4s ease-in-out -.25s infinite; }
  .is-idle .pupils { animation: look 6.5s ease-in-out infinite; }

  /* wave */
  .is-wave .body { animation: bobSmall 1s ease-in-out infinite; }
  .is-wave .arm-l { transform: rotate(14deg); }
  .is-wave .arm-r { animation: wave .5s ease-in-out infinite alternate; }
  .is-wave .tuft { animation: tuft 1s ease-in-out infinite; }

  /* think */
  .is-think .body { animation: sway 3s ease-in-out infinite; }
  .is-think .arm-l { transform: rotate(9deg); }
  .is-think .arm-r { transform: rotate(-108deg); }
  .is-think .eyes { transform: translate(5px, -4px); }

  /* sleep */
  .is-sleep .body { animation: breathe 3.6s ease-in-out infinite; }
  .is-sleep .arm-l { transform: rotate(7deg); }
  .is-sleep .arm-r { transform: rotate(-7deg); }
  .zzz text { opacity: 0; animation: zzz 2.4s linear infinite; transform-origin: 150px 110px; }
  .zzz .z2 { animation-delay: 1.2s; }

  /* celebrate */
  .is-celebrate .body { animation: jump 1.1s ease-in-out infinite; }
  .is-celebrate .arm-l { animation: cheerL 1.1s ease-in-out infinite; }
  .is-celebrate .arm-r { animation: cheerR 1.1s ease-in-out infinite; }
  .is-celebrate .shadow { animation: shadowJ 1.1s ease-in-out infinite; }

  @keyframes bob { 50% { transform: translateY(-7px) rotate(-1.2deg); } }
  @keyframes bobSmall { 50% { transform: translateY(-3px) rotate(1.5deg); } }
  @keyframes armL { 0%, 100% { transform: rotate(9deg); } 50% { transform: rotate(16deg); } }
  @keyframes armR { 0%, 100% { transform: rotate(-9deg); } 50% { transform: rotate(-16deg); } }
  @keyframes tuft { 0%, 100% { transform: rotate(-4deg); } 50% { transform: rotate(5deg); } }
  @keyframes look { 0%, 38% { transform: translateX(0); } 48%, 58% { transform: translateX(3.5px); } 70%, 80% { transform: translateX(-3.5px); } 90%, 100% { transform: translateX(0); } }
  @keyframes blink { 0%, 92%, 97%, 100% { transform: scaleY(1); } 94.5% { transform: scaleY(.08); } }
  @keyframes wave { from { transform: rotate(-128deg); } to { transform: rotate(-158deg); } }
  @keyframes sway { 0%, 100% { transform: rotate(-2.5deg); } 50% { transform: rotate(2.5deg); } }
  @keyframes breathe { 50% { transform: translateY(4px); } }
  @keyframes zzz { 0% { opacity: 0; transform: translate(0, 0) scale(.6); } 20% { opacity: 1; } 100% { opacity: 0; transform: translate(20px, -44px) scale(1.25); } }
  @keyframes jump { 0%, 100% { transform: translateY(0); } 28%, 48% { transform: translateY(-34px); } 64% { transform: translateY(0); } 68% { transform: scale(1.1, .9); } }
  @keyframes cheerL { 0%, 100% { transform: rotate(140deg); } 28% { transform: rotate(120deg); } }
  @keyframes cheerR { 0%, 100% { transform: rotate(-140deg); } 28% { transform: rotate(-120deg); } }
  @keyframes shadowJ { 0%, 100% { transform: scale(1); opacity: .35; } 40% { transform: scale(.6); opacity: .15; } }
</style>
