---
import Icon from './Icon.astro';
import { products } from '../data/content';
const cols = [[products[0]], [products[1], products[2]]];
---
<section class="bt">
  <div class="container wrap">
    <h2 class="h-heading">Todo lo que trae</h2>
    <div class="cols">
      {cols.map((col) => (
        <div>
          {col.map((g) => (
            <div class="group">
              <h3>{g.group}</h3>
              <ul>
                {g.items.map(([ic, t, d]) => (
                  <li class="it">
                    <div class="ic"><Icon name={ic} /></div>
                    <a href="/#funciones">{t}</a>
                    <p>{d}</p>
                    <Icon name="arrow" class="arr" />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .wrap { padding-block: 96px; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; margin-top: 48px; }
  .group + .group { margin-top: 36px; }
  h3 { font-family: var(--mono); font-size: 12px; text-transform: uppercase; color: var(--fg-2); font-weight: 400; padding-bottom: 12px; border-bottom: 1px solid var(--border); }
  .it { position: relative; display: grid; grid-template-columns: 44px 1fr 20px; gap: 4px 16px; align-items: center; padding: 18px 0; border-bottom: 1px solid var(--border); }
  .ic { grid-row: span 2; width: 44px; height: 44px; border: 1px solid var(--border-strong); border-radius: 10px; display: grid; place-items: center; color: var(--accent); transition: .2s; }
  .ic :global(svg) { width: 20px; height: 20px; }
  a { font-size: 18px; font-weight: 500; }
  a::after { content: ''; position: absolute; inset: 0; }
  p { grid-column: 2; color: var(--fg-2); font-size: 15px; }
  .it :global(.arr) { grid-row: 1 / 3; grid-column: 3; width: 18px; height: 18px; color: var(--fg-4); transition: .2s; }
  .it:hover :global(.arr) { color: var(--fg); transform: translateX(4px); }
  .it:hover .ic { background: var(--surface); }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr; } }
</style>
