---
import Base from '../layouts/Base.astro';
import { author } from '../data/social';
import { REPO_URL } from '../data/downloads';

const updated = '30 de septiembre de 2026';

const sections: { id: string; title: string; body: string[] }[] = [
  {
    id: 'acuerdo',
    title: 'Acuerdo',
    body: [
      `Estos términos aplican cuando descargas, instalas o usas Cronos (la app) y cuando visitas este sitio web. Cronos es un proyecto independiente de ${author.name}. Al usar la app o el sitio, aceptas estos términos. Si no estás de acuerdo, no uses la app ni el sitio.`,
    ],
  },
  {
    id: 'la-app',
    title: 'La app',
    body: [
      'Cronos es una app gratuita para Android que te ayuda a registrar y medir cómo usas tu tiempo: tareas, actividades, eventos, agenda y métricas.',
      'Funciona sin cuenta y sin servidor. Las funciones pueden cambiar entre versiones, y algunas descritas en este sitio pueden no estar disponibles en todas.',
    ],
  },
  {
    id: 'privacidad',
    title: 'Tus datos y privacidad',
    body: [
      'Todo lo que registras en Cronos se guarda solo en tu teléfono, en una base de datos local. No tenemos servidores que reciban tus datos y no podemos verlos.',
      'Algunas funciones usan permisos de Android, siempre opcionales: notificaciones (recordatorios), “Acceso al uso” (para medir el uso real del teléfono y App Tracking) y biometría del sistema (bloqueo). Puedes negarlos o revocarlos desde Ajustes de Android.',
      'Para revisar si hay versiones nuevas, la app consulta la API pública de GitHub Releases. Esa consulta no incluye ninguno de tus datos.',
      'Si usas “Compartir un resumen con tu IA”, Cronos arma un texto con tus datos y abre el menú de compartir de Android: tú eliges a qué app enviarlo, y desde ese momento aplican los términos de esa app.',
      'Eres responsable de tus copias de seguridad. Cronos te deja exportar (CSV, JSON, PDF) y hacer un backup completo restaurable.',
    ],
  },
  {
    id: 'licencia',
    title: 'Uso de la app',
    body: [
      `Te damos un permiso personal, no exclusivo e intransferible para instalar y usar Cronos en tus dispositivos. El código fuente es público en GitHub (${REPO_URL}); la licencia de cada versión se publica junto a ella.`,
      'No vendas, alquiles ni redistribuyas versiones modificadas haciéndolas pasar por oficiales.',
    ],
  },
  {
    id: 'descargas',
    title: 'Descargas',
    body: [
      'El APK oficial se descarga desde este sitio, que lo enlaza a GitHub Releases. No instales copias de Cronos obtenidas de otras fuentes: no podemos garantizar que no hayan sido alteradas.',
    ],
  },
  {
    id: 'newsletter',
    title: 'Newsletter',
    body: [
      'Si te suscribes al newsletter, usamos tu correo solo para enviarte novedades de Cronos y de otros proyectos gratuitos del autor. No lo vendemos ni lo compartimos con terceros con fines comerciales.',
      'El correo se envía a través de un proveedor SMTP. Puedes darte de baja cuando quieras respondiendo a cualquier correo o escribiendo a ' + author.email + '.',
    ],
  },
  {
    id: 'cookies',
    title: 'Cookies en este sitio',
    body: [
      'Este sitio solo guarda una cosa en tu navegador: tu elección de cookies, para no preguntarte en cada visita. Se guarda en el almacenamiento local del navegador y nunca sale de tu dispositivo.',
      'Hoy no usamos cookies de analítica, publicidad ni rastreo. Si eso cambia, quedarán apagadas salvo que las permitas.',
      'Puedes cambiar tu elección en cualquier momento desde “Ajustes de cookies”, al pie de cada página.',
    ],
  },
  {
    id: 'uso-aceptable',
    title: 'Uso aceptable',
    body: ['No uses la app ni este sitio para infringir la ley, violar derechos de terceros, ni para intentar dañar o interrumpir el sitio (por ejemplo, abusando del formulario del newsletter).'],
  },
  {
    id: 'garantia',
    title: 'Sin garantía',
    body: ['Cronos se ofrece “tal cual”. Trabajamos para que sea estable y cuide tus datos, pero no podemos garantizar que esté libre de errores o interrupciones.'],
  },
  {
    id: 'responsabilidad',
    title: 'Limitación de responsabilidad',
    body: ['En la medida en que la ley lo permita, no somos responsables de pérdidas indirectas ni de pérdida de datos derivadas del uso de la app o del sitio.'],
  },
  {
    id: 'cambios',
    title: 'Cambios en estos términos',
    body: ['Podemos actualizar estos términos. Cuando lo hagamos, cambiaremos la fecha al inicio de esta página. Si sigues usando la app o el sitio después de una actualización, aplican los nuevos términos.'],
  },
  {
    id: 'contacto',
    title: 'Contacto',
    body: [`¿Preguntas sobre estos términos? Escribe a ${author.email} o visita ${author.site}.`],
  },
];
---
<Base title="Términos y condiciones — Cronos" description="Términos de uso de Cronos y de este sitio: tus datos son tuyos, sin cuenta, y cookies al mínimo.">
  <section class="head">
    <div class="container">
      <p class="eyebrow mono">Legal · Última actualización: {updated}</p>
      <h1 class="h-display">Términos y condiciones</h1>
      <p class="lede">La versión corta: tus datos son tuyos y viven en tu teléfono, la app funciona sin cuenta y este sitio usa las cookies mínimas.</p>
    </div>
  </section>
  <div class="container legal">
    <nav class="toc" aria-label="En esta página">
      <p class="mono">En esta página</p>
      <ol>{sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}</ol>
    </nav>
    <div class="body">
      {sections.map((s, i) => (
        <section id={s.id}>
          <h2><span class="mono">{String(i + 1).padStart(2, '0')}</span>{s.title}</h2>
          {s.body.map((p) => <p>{p}</p>)}
        </section>
      ))}
    </div>
  </div>
</Base>

<style>
  .head { padding: clamp(48px, 7vw, 96px) 0 48px; border-bottom: 1px solid var(--border); }
  .eyebrow { font-size: 12px; color: var(--fg-3); margin-bottom: 20px; }
  .head h1 { font-size: clamp(44px, 7vw, 88px); }
  .lede { margin-top: 20px; max-width: 640px; }
  .legal { display: grid; grid-template-columns: 260px 1fr; gap: 64px; padding-block: 64px 96px; }
  .toc { position: sticky; top: calc(var(--header) + 24px); align-self: start; }
  .toc p { font-size: 12px; color: var(--fg-3); margin-bottom: 12px; }
  .toc ol { list-style: none; border-left: 1px solid var(--border); }
  .toc a { display: block; padding: 6px 14px; font-size: 14px; color: var(--fg-2); }
  .toc a:hover { color: var(--fg); }
  .body { max-width: 720px; }
  .body section { padding-bottom: 36px; margin-bottom: 36px; border-bottom: 1px solid var(--border); scroll-margin-top: calc(var(--header) + 24px); }
  .body h2 { display: flex; gap: 14px; align-items: baseline; font-weight: 400; font-size: 26px; letter-spacing: -.02em; margin-bottom: 14px; }
  .body h2 span { font-size: 13px; color: var(--accent); }
  .body p { color: var(--fg-2); margin-top: 12px; line-height: 1.65; }
  @media (max-width: 860px) { .legal { grid-template-columns: 1fr; gap: 32px; } .toc { position: static; } }
</style>
